# Copy to .env (or set these directly in your deployment) and fill in as needed.
# None are required - each has a sensible default for local development.

# Path to the SQLite database file. Defaults to backend/shopping.db.
# DATABASE_PATH=/data/shopping.db

# Directory the built frontend is served from in production. Defaults to backend/static.
# STATIC_DIR=/app/static

# Enables the Werkzeug debugger when running `python app.py` directly.
# Never set this in production - gunicorn (see docker-compose.yml) ignores it anyway.
# FLASK_DEBUG=1
