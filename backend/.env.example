# Copy to .env (or set these directly in your deployment) and fill in as needed.
# None are required - each has a sensible default for local development.

# Path to the SQLite database file. Defaults to backend/shopping.db.
# DATABASE_PATH=/data/shopping.db

# Directory the built frontend is served from in production. Defaults to backend/static.
# STATIC_DIR=/app/static

# Enables the Werkzeug debugger when running `python app.py` directly.
# Never set this in production - gunicorn (see docker-compose.yml) ignores it anyway.
# FLASK_DEBUG=1

# Shared secret for the hidden /admin page (reset PINs/lockouts, delete
# profiles, moderate products). Not set by default, which disables admin
# access entirely - set this to enable it.
# ADMIN_PASSWORD=change-me

# Where the settings.json file lives, Defaults to sitting next to DATABASE_PATH,
# so it persists on the same volume without extra config in most deployments.
# SETTINGS_PATH=/data/settings.json

# Where product photo thumbnails (WebP, ~100-128px) are stored. Defaults to
# sitting next to DATABASE_PATH, same reasoning as SETTINGS_PATH above.
# PRODUCT_IMAGE_DIR=/data/product-images
